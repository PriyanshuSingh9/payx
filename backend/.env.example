# PayX Backend Environment Configuration

PORT=8787
NODE_ENV=development

# Database (Neon Postgres)
# DIRECT_URL is required for Prisma schema generation and migrations.
# DATABASE_URL is pooled connection used at runtime.
DATABASE_URL=postgresql://user:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep.region.aws.neon.tech/neondb?sslmode=require

# Auth
GOOGLE_CLIENT_ID=your-payx-google-client-id.apps.googleusercontent.com
JWT_SECRET=super_secret_dev_key_for_payx
CORS_ORIGIN=*

# Feature flags
ENABLE_DEMO_BOOTSTRAP=true
ENABLE_BLOCKCHAIN=true
ENABLE_DEMO_ADMIN=false

# Solana
SOLANA_RPC_URL=http://127.0.0.1:8899
PAYX_PROGRAM_ID=
USDC_MINT_ADDRESS=
OPERATOR_KEYPAIR_PATH=

# Ramps
MOCK_RAMP_DELAY_MS=3000
