# ==============================================================================
# PayX Environment Configuration Example
# Copy this file to .env or backend/.env and replace values for your environment.
# ==============================================================================

# Server
PORT=8787
NODE_ENV=development

# Database (Neon Postgres)
# DIRECT_URL is required for Prisma migrations and schema engine generation.
# DATABASE_URL is the pooled connection used by Prisma Client at runtime.
DATABASE_URL=postgresql://user:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep.region.aws.neon.tech/neondb?sslmode=require

# Authentication & Security
GOOGLE_CLIENT_ID=612184936512-j4tl40a3lmd793k0cirue0t2lca8660k.apps.googleusercontent.com
JWT_SECRET=super_secret_dev_key_for_payx
CORS_ORIGIN=*

# Feature Flags
ENABLE_DEMO_BOOTSTRAP=true
ENABLE_BLOCKCHAIN=true
ENABLE_DEMO_ADMIN=false

# Solana Configuration
# Local validator: http://127.0.0.1:8899 | Devnet: https://api.devnet.solana.com
SOLANA_RPC_URL=http://127.0.0.1:8899
# Deployed PayX Escrow Anchor program ID (update after anchor keys sync / deploy)
PAYX_PROGRAM_ID=11111111111111111111111111111111
# Circle Devnet USDC mint: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Path to local operator/relayer keypair JSON (default: ~/.config/solana/id.json)
OPERATOR_KEYPAIR_PATH=~/.config/solana/id.json

# Ramp Provider Simulation
MOCK_RAMP_DELAY_MS=3000
